          "children": [
            "title",
            "intro",
            "table",
            "footer"
          ]
        },
        {
          "id": "title",
          "component": "Text",
          "variant": "h4",
          "text": "Size guide"
        },
        {
          "id": "intro",
          "component": "Text",
          "text": "Measure your foot from heel to toe, then find your size."
        },
        {
          "id": "table",
          "component": "FootScanner3D",
